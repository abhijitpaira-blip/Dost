# --- Server ---
ENVIRONMENT=development           # development | staging | production
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase (server-side only — NEVER prefix these with NEXT_PUBLIC_) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me   # secret. server-side only. bypasses RLS.
SUPABASE_JWT_SECRET=replace-me         # Project Settings → API → JWT Secret. Used to verify user tokens.

# --- Admin dashboard (frontend's /admin screen, backend/app/api/v1/admin.py) ---
# Comma-separated Supabase Auth UUIDs allowed to see aggregate usage stats —
# NOT an email. Find your own: Supabase dashboard -> Authentication -> Users
# -> your row -> copy the "UID" column. Leave empty to disable admin access
# for everyone (every request gets a 403).
ADMIN_USER_IDS=

# --- AI provider (Phase 2) — modular: set AI_PROVIDER to switch, only the
# matching key below needs a real value. ---
AI_PROVIDER=anthropic                  # anthropic | openai
ANTHROPIC_API_KEY=replace-me           # required when AI_PROVIDER=anthropic
# OPENAI_API_KEY=                      # required when AI_PROVIDER=openai

# --- Voice (Speechma text-to-speech) ---
# SPEECHMA_API_KEY=replace-me            # sign up at speechma.com, dashboard -> API keys
#
# Voice ids per language: Speechma has 580+ voices across 60+ languages, so
# there's no universal default. Once SPEECHMA_API_KEY is set, run this once
# to see real ids and pick voices that sound right:
#   python -c "import asyncio; from services.voice.speechma_client import list_voices; \
#     print(asyncio.run(list_voices(language='Hindi')))"
# (swap 'Hindi' for 'Bengali' / 'English' too), then set the ones below —
# see services/voice/language_voices.py.
# SPEECHMA_VOICE_ENGLISH=
# SPEECHMA_VOICE_HINDI=
# SPEECHMA_VOICE_BENGALI=
# SPEECHMA_VOICE_DEFAULT=                # used when a language-specific voice isn't set
