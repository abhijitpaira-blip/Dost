# --- Server ---
ENVIRONMENT=development           # development | staging | production
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase (server-side only — NEVER prefix these with NEXT_PUBLIC_) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me   # secret. server-side only. bypasses RLS.
SUPABASE_JWT_SECRET=replace-me         # Project Settings → API → JWT Secret. Used to verify user tokens.

# --- AI provider(s) — wired up in a later phase, keys live here when they arrive ---
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Voice (Speechma) — wired up in a later phase ---
# SPEECHMA_API_KEY=
