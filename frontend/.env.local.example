# Safe to expose to the browser — Supabase anon key is designed for this,
# and RLS is what actually protects data, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# NEVER add a service-role key, AI key, or Speechma key here — those stay in
# backend/.env only. Anything prefixed NEXT_PUBLIC_ ships to every visitor's browser.
